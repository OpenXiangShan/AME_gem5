    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        const auto &zttSrcReg = ZttMs1Reg;
        const uint32_t zttDest = RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttSrc = RiscvISA::ZttMatRegBase + ZTT_MS1;
        const RegVal zttDestType = ZttMdData;
        const RegVal zttSrcType = ZttMs1Data;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};

def format ZttArithShiftOp(*flags) {{
    code = '''
        ZttTypeInfo destType, srcType;
        uint32_t len;
        if (!zttGetDatatype(xc, zttDest, false, zttDestType, destType) ||
            !zttGetDatatype(xc, zttSrc, false, zttSrcType, srcType) ||
            !zttTileLen(xc, destType, len) ||
            !zttTileLen(xc, srcType, len))
            return NoFault;
        zttExecuteShift(zttDestReg, zttSrcReg, destType, srcType, len,
                        ZTT_SHIFT_IMM);
    '''
    iop = InstObjParams(name, Name, 'ZttArithStaticInst',
                        {'code': code,
                         'operands':
                         'ZttMdReg = zttDestReg; ZttMdData; '
                         'ZttMs1Reg; ZttMs1Data;'}, zttArithFlags(flags))
    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        const auto &zttSrcReg = ZttMs1Reg;
        const uint32_t zttDest = RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttSrc = RiscvISA::ZttMatRegBase + ZTT_MS1;
        const RegVal zttDestType = ZttMdData;
        const RegVal zttSrcType = ZttMs1Data;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};

def format ZttArithRowZipOp(*flags) {{
    code = '''
        ZttTypeInfo destType, lhsType, rhsType;
        uint32_t len;
        if ((ZTT_MD & 1) || ZTT_MD + 1 >= RiscvISA::NumZttMatRegs ||
            !zttGetDatatype(xc, zttDest, false, zttDestType, destType) ||
            !zttGetDatatype(xc, zttLhs, false, zttLhsType, lhsType) ||
            !zttGetDatatype(xc, zttRhs, false, zttRhsType, rhsType) ||
            !zttTileLen(xc, destType, len) ||
            !zttTileLen(xc, lhsType, len) ||
            !zttTileLen(xc, rhsType, len))
            return NoFault;
        zttExecuteRowZip(zttDestReg, zttDestNextReg, zttLhsReg,
                         zttRhsReg, destType, lhsType, rhsType, len);
    '''
    iop = InstObjParams(name, Name, 'ZttArithStaticInst',
                        {'code': code,
                         'operands':
                         'ZttMdReg = zttDestReg; '
                         'ZttMdNextReg = zttDestNextReg; ZttMdData; '
                         'ZttMs1Reg; ZttMs1Data; '
                         'ZttMs2Reg; ZttMs2Data;'}, zttArithFlags(flags))
    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        auto &zttDestNextReg = ZttMdNextReg;
        const auto &zttLhsReg = ZttMs1Reg;
        const auto &zttRhsReg = ZttMs2Reg;
        const uint32_t zttDest = RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttLhs = RiscvISA::ZttMatRegBase + ZTT_MS1;
        const uint32_t zttRhs = RiscvISA::ZttMatRegBase + ZTT_MS2;
        const RegVal zttDestType = ZttMdData;
        const RegVal zttLhsType = ZttMs1Data;
        const RegVal zttRhsType = ZttMs2Data;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};

def format ZttArithRowUnzipOp(*flags) {{
    code = '''
        ZttTypeInfo destType, srcType;
        uint32_t len;
        if ((ZTT_MD & 1) || ZTT_MD + 1 >= RiscvISA::NumZttMatRegs ||
            ZTT_MS1 + 1 >= RiscvISA::NumZttMatRegs ||
            !zttGetDatatype(xc, zttDest, false, zttDestType, destType) ||
            !zttGetDatatype(xc, zttSrc, false, zttSrcType, srcType) ||
            !zttTileLen(xc, destType, len) ||
            !zttTileLen(xc, srcType, len))
            return NoFault;
        zttExecuteRowUnzip(zttDestReg, zttDestNextReg, zttSrcReg,
                           zttSrcNextReg, destType, srcType, len);
    '''
    iop = InstObjParams(name, Name, 'ZttArithStaticInst',
                        {'code': code,
                         'operands':
                         'ZttMdReg = zttDestReg; '
                         'ZttMdNextReg = zttDestNextReg; ZttMdData; '
                         'ZttMs1Reg; ZttMs1NextReg; ZttMs1Data;'},
                        zttArithFlags(flags))
    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        auto &zttDestNextReg = ZttMdNextReg;
        const auto &zttSrcReg = ZttMs1Reg;
        const auto &zttSrcNextReg = ZttMs1NextReg;
        const uint32_t zttDest = RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttSrc = RiscvISA::ZttMatRegBase + ZTT_MS1;
        const RegVal zttDestType = ZttMdData;
        const RegVal zttSrcType = ZttMs1Data;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};

def format ZttInPlaceZipOp(column, unzip, *flags) {{
    code = '''
        if (ZTT_MS1 == ZTT_MS2)
            return std::make_shared<IllegalInstFault>(
                "AME zip operands must be distinct", machInst);
        ZttTypeInfo firstType, secondType;
        uint32_t len;
        if (!zttGetDatatype(xc, zttFirst, false, zttFirstType,
                            firstType) ||
            !zttGetDatatype(xc, zttSecond, false, zttSecondType,
                            secondType) ||
            !zttTileLen(xc, firstType, len) ||
            !zttTileLen(xc, secondType, len))
            return NoFault;
        uint32_t packFactor, groupSize;
        if (zttFirstType != zttSecondType ||
            !zttPackFactor(xc, firstType, packFactor) ||
            !zttGroupSize(xc, firstType, groupSize) || packFactor != 1) {
            zttSetUnsupported(xc);
            return NoFault;
        }
        const uint32_t firstBase =
            zttFirst - RiscvISA::ZttMatRegBase;
        const uint32_t secondBase =
            zttSecond - RiscvISA::ZttMatRegBase;
        uint32_t firstSpan, secondSpan;
        if (!zttMSpan(firstBase, 1, 1, groupSize, firstSpan) ||
            !zttMSpan(secondBase, 1, 1, groupSize, secondSpan))
            return std::make_shared<IllegalInstFault>(
                "invalid AME zip register span", machInst);
        ZttMRegArray firstSource{}, secondSource{};
        ZttMRegArray firstResult{}, secondResult{};
        zttSnapshotMOperand(
            xc, firstBase, firstSpan, zttFirstReg, firstSource);
        zttSnapshotMOperand(
            xc, secondBase, secondSpan, zttSecondReg, secondSource);
        for (uint32_t i = 0; i < firstSpan; ++i)
            firstResult[i].zero();
        for (uint32_t i = 0; i < secondSpan; ++i)
            secondResult[i].zero();
        const uint64_t physicalBits = zttPhysicalMRegBits(xc, len);
        const auto a = zttExtractMOperandSquare(
            firstSource, physicalBits, firstType, len, 0);
        const auto b = zttExtractMOperandSquare(
            secondSource, physicalBits, secondType, len, 0);
        RiscvISA::MatRegContainer firstOutput, secondOutput;
        firstOutput.zero();
        secondOutput.zero();
        for (uint32_t logical = 0; logical < 2 * len; ++logical)
            for (uint32_t other = 0; other < len; ++other) {
                uint32_t srcLogical;
                bool fromSecond;
                if (%s) {
                    srcLogical = logical / 2;
                    fromSecond = logical & 1;
                } else {
                    srcLogical = 2 * (logical %% len) + (logical >= len);
                    fromSecond = srcLogical >= len;
                    srcLogical %%= len;
                }
                const uint32_t srcRow = %s ? other : srcLogical;
                const uint32_t srcCol = %s ? srcLogical : other;
                const auto value = zttReadTileElement(
                    fromSecond ? b : a, firstType, len, srcRow, srcCol);
                zttWriteTileElement(
                    logical < len ? firstOutput : secondOutput,
                    firstType, len,
                    %s ? other : logical %% len,
                    %s ? logical %% len : other,
                    value);
            }
        zttInsertMOperandSquare(
            firstResult, physicalBits, firstType, len, 0, firstOutput);
        zttInsertMOperandSquare(
            secondResult, physicalBits, secondType, len, 0, secondOutput);
        zttCommitMOperand(
            xc, firstBase, firstSpan, firstResult, zttFirstReg);
        zttCommitMOperand(
            xc, secondBase, secondSpan, secondResult, zttSecondReg);
    ''' % tuple('true' if value else 'false' for value in
                (not unzip, column, column, column, column))
    # The v0.6 encoding fixes rd=x0; ms1 and ms2 are both read/write.
    iop = InstObjParams(name, Name, 'ZttArithStaticInst',
                        {'code': code,
                         'operands':
                         'ZttMs1Reg = zttFirstReg; '
                         'ZttMs2Reg = zttSecondReg; '
                         'ZttMs1Data; ZttMs2Data; '
                         'ZttMs1Reg; ZttMs2Reg;'}, zttArithFlags(flags))
    iop.ztt_aliases = '''
        auto &zttFirstReg = ZttMs1Reg;
        auto &zttSecondReg = ZttMs2Reg;
        const uint32_t zttFirst = RiscvISA::ZttMatRegBase + ZTT_MS1;
        const uint32_t zttSecond = RiscvISA::ZttMatRegBase + ZTT_MS2;
        const RegVal zttFirstType = ZttMs1Data;
        const RegVal zttSecondType = ZttMs2Data;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};

def format ZttArithZeroOp(code, *flags) {{
    iop = InstObjParams(name, Name, 'ZttArithStaticInst',
                        {'code': code,
                         'operands':
                         'ZttAdReg = zttAccReg; ZttAdData;'},
                        zttArithFlags(flags))
    iop.ztt_aliases = '''
        auto &zttAccReg = ZttAdReg;
        [[maybe_unused]] const uint32_t zttAcc =
            RiscvISA::ZttAccRegBase + ZTT_AD;
        [[maybe_unused]] const RegVal zttAccType = ZttAdData;
    '''
    header_output = ZttArithDeclare.subst(iop)
    decoder_output = ZttArithConstructor.subst(iop)
    decode_block = ZttArithDecode.subst(iop)
    exec_output = ZttArithExecute.subst(iop)
}};
