            RiscvISA::ZttMatRegBase + ZTT_MD;
        [[maybe_unused]] const uint32_t zttSrc =
            RiscvISA::ZttAccRegBase + ZTT_AMOV_AS;
        const RegVal zttDestType = ZttMdData;
