// Ztt v0.6 accumulator/tile move instructions.

// ================== Ztt move instruction support ===========================
output header {{
class ZttMoveStaticInst : public ZttStaticInst
{
  protected:
    ZttMoveStaticInst(const char *mnem, ExtMachInst machInst, OpClass opClass)
        : ZttStaticInst(mnem, machInst, opClass)
    {}
};
}};

def template ZttMoveDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        using %(base_class)s::generateDisassembly;
    };
}};

def template ZttMoveConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
    }
}};

def template ZttMoveDecode {{
    return new %(class_name)s(machInst);
}};

def template ZttMoveExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Fault zttAccessFault = checkAccess(xc);
        if (zttAccessFault != NoFault)
            return zttAccessFault;
        %(op_decl)s;
        /* %(operands)s */
        %(op_rd)s;
        ZttFpEnv zttFpEnv;
        %(ztt_aliases)s
        %(code)s;
        %(op_wb)s;
        zttFpEnv.commit(xc);
        markDirty(xc);
        return NoFault;
    }
}};

def template ZttMoveReadExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Fault zttAccessFault = checkAccess(xc);
        if (zttAccessFault != NoFault)
            return zttAccessFault;
        %(op_decl)s;
        /* %(operands)s */
        %(op_rd)s;
        %(ztt_aliases)s
        %(code)s;
        %(op_wb)s;
        return NoFault;
    }
}};

def format ZttTileMoveOp(code, *flags) {{
    iop = InstObjParams(name, Name, 'ZttMoveStaticInst',
                         {'code': code,
                         'operands':
                         'ZttMdReg = zttDestReg; '
                         'ZttMdData; '
                         'ZttMsReg; ZttMsData;'},
                        flags + ('IsSerializeBefore', 'IsSerializeAfter'))
    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        const auto &zttSrcReg = ZttMsReg;
        [[maybe_unused]] const uint32_t zttDest =
            RiscvISA::ZttMatRegBase + ZTT_MD;
        [[maybe_unused]] const uint32_t zttSrc =
            RiscvISA::ZttMatRegBase + ZTT_MS;
        const RegVal zttDestType = ZttMdData;
        const RegVal zttSrcType = ZttMsData;
    '''
    header_output = ZttMoveDeclare.subst(iop)
    decoder_output = ZttMoveConstructor.subst(iop)
    decode_block = ZttMoveDecode.subst(iop)
    exec_output = ZttMoveExecute.subst(iop)
}};

