def format ZttStridedLoadOp(transposed, *flags) {{
    iop = InstObjParams(name, Name, 'ZttMemStaticInst',
                        {'code': zttStridedLoadBehaviour(transposed, False),
                         'initiate_code':
                         zttStridedLoadInitiateBehaviour(transposed),
                         'initiate_operands':
                         'ZttMdData; ZttXs1; ZttXs2;',
                         'complete_code':
                         zttStridedLoadBehaviour(transposed, True),
                         'complete_operands':
                         'ZttMdReg = zttDestReg; ZttMdData; ZttXs2;',
                         'operands':
                         'ZttMdReg = zttDestReg; ZttMdData; '
                         'ZttXs1; ZttXs2;'},
                        flags + ('IsLoad', 'IsSerializeBefore',
                                 'IsSerializeAfter'))
    iop.ztt_aliases = '''
        auto &zttDestReg = ZttMdReg;
        const Addr zttBase = ZttXs1;
        const uint64_t zttStride = ZttXs2;
        const uint32_t zttRegIndex =
            RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttRegSelector = ZTT_MD;
        const RegVal zttRegType = ZttMdData;
        constexpr bool zttIsLoad = true;
    '''
    iop.initiate_aliases = '''
        const Addr zttBase = ZttXs1;
        const uint64_t zttStride = ZttXs2;
        const uint32_t zttRegIndex =
            RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttRegSelector = ZTT_MD;
        const RegVal zttRegType = ZttMdData;
        constexpr bool zttIsLoad = true;
    '''
    iop.complete_aliases = '''
        auto &zttDestReg = ZttMdReg;
        const Addr zttBase = pkt->req->getVaddr();
        const uint64_t zttStride = ZttXs2;
        const uint32_t zttRegIndex =
            RiscvISA::ZttMatRegBase + ZTT_MD;
        const uint32_t zttRegSelector = ZTT_MD;
        const RegVal zttRegType = ZttMdData;
        constexpr bool zttIsLoad = true;
    '''
    header_output = ZttMemDeclare.subst(iop)
    decoder_output = ZttMemConstructor.subst(iop)
    decode_block = ZttMemDecode.subst(iop)
    exec_output = (ZttMemExecute.subst(iop) +
                   ZttMemInitiateAcc.subst(iop) +
                   ZttMemCompleteAcc.subst(iop))
}};

